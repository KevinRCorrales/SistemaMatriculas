# =============================================================================
# Plantilla de variables de entorno · Sistema de Matrículas
# -----------------------------------------------------------------------------
# Copia este archivo como .env y completa las credenciales en tu equipo:
#
#     cp .env.example .env
#
# El archivo .env está ignorado por git y NUNCA debe contener valores
# publicados. Esta plantilla no incluye contraseñas ni usuarios reales.
# =============================================================================

# --- MariaDB (obligatorio) ---------------------------------------------------
# Se admiten los nombres históricos usados por sistema.py (USER, PASSWORD,
# DATABASE, HOST) y los nombres explícitos DATABASE_*.
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=universidad
DATABASE_HOST=localhost
DATABASE_PORT=3306

# --- Servidor FastAPI (opcional) --------------------------------------------
# Solo se usan al ejecutar `python servidor.py`.
API_HOST=127.0.0.1
API_PORT=3000
API_RELOAD=false

# --- Frontend (opcional) -----------------------------------------------------
# Origen autorizado por CORS. Si el backend sirve la carpeta web/, el portal
# usa el mismo origen y CORS no interviene.
FRONTEND_ORIGIN=http://127.0.0.1:3000
