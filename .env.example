# =============================================================================
# Plantilla de variables de entorno · Sistema de Matrículas
# -----------------------------------------------------------------------------
# Copia este archivo como .env y completa las credenciales en tu equipo:
#
#     cp .env.example .env
#
# El archivo .env está ignorado por git y NUNCA debe contener valores
# publicados. Esta plantilla no incluye contraseñas ni usuarios reales.
# =============================================================================

# --- MariaDB (obligatorio) ---------------------------------------------------
# Se admiten los nombres históricos usados por sistema.py (USER, PASSWORD,
# DATABASE, HOST) y los nombres explícitos DATABASE_*.
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=universidad
DATABASE_HOST=localhost
DATABASE_PORT=3306

# --- Servidor FastAPI (opcional) --------------------------------------------
# Solo se usan al ejecutar `python servidor.py`.
API_HOST=127.0.0.1
API_PORT=3000
API_RELOAD=false

# Al iniciar, recompila web/dist si falta o si el frontend cambió (requiere npm).
# Usa 0 si prefieres compilar manualmente con `npm run build`.
PORTAL_AUTO_BUILD=1

# --- Acceso administrativo (obligatorio para el login) -----------------------
# Contraseña única compartida por los administrativos. No se publica en el
# frontend: la API la compara contra este valor y nunca la devuelve.
ADMIN_PASSWORD=

# Secreto con el que se firman los tokens de sesión. Usa una cadena aleatoria
# larga (por ejemplo: python -c "import secrets; print(secrets.token_hex(32))").
SESSION_SECRET=

# --- Frontend (opcional) -----------------------------------------------------
# Origen autorizado por CORS. Si el backend sirve la carpeta web/, el portal
# usa el mismo origen y CORS no interviene.
FRONTEND_ORIGIN=http://127.0.0.1:3000
